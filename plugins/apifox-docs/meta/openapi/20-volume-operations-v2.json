  "paths": {
    "/v2/volumes": {
      "get": {
        "summary": "List Volumes",
        "deprecated": false,
        "description": "This operation lists all volumes in the specified project.",
        "x-i18n": {
          "zh-CN": {
            "summary": "查看 Volume 列表",
            "description": "本接口将列出指定项目下的所有 Volume。"
          }
        },
        "tags": [
          "Volume Operations (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be <include target=\"zilliz\">an API key with appropriate privileges or </include>a pair of colon-joined username and password, like `username:password`.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为<include target=\"zilliz\">具备适当权限的 API 密钥或</include>用冒号分隔的用户名和密码，如 `username:password`。"
              }
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "description": "The target project of this operation.",
            "x-i18n": {
              "zh-CN": {
                "description": "当前操作的目标项目。"
              }
            },
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "proj-xxxxxxxxxxxxxxxxx"
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "The number of records to include in each response.",
            "x-i18n": {
              "zh-CN": {
                "description": "每次返回的记录数。"
              }
            },
            "required": false,
            "example": 10,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "currentPage",
            "in": "query",
            "description": "The current page number.",
            "x-i18n": {
              "zh-CN": {
                "description": "当前页码。"
              }
            },
            "required": false,
            "example": 1,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "The category of the volume. Valid values are `MANAGED` and `EXTERNAL`.",
            "x-i18n": {
              "zh-CN": {
                "description": "Volume 的类别。有效值为 `MANAGED` 和 `EXTERNAL`。"
              }
            },
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the list of volumes.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回 Volume 列表。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns a list of volumes.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回 Volume 列表。"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "count": {
                              "type": "integer",
                              "description": "The total number of volumes.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "Volume 总数。"
                                }
                              }
                            },
                            "currentPage": {
                              "type": "integer",
                              "description": "The current page number.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "当前页码。"
                                }
                              }
                            },
                            "pageSize": {
                              "type": "integer",
                              "description": "The number of records in each response.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "每页记录数。"
                                }
                              }
                            },
                            "volumes": {
                              "type": "array",
                              "description": "The list of volumes.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "Volume 列表。"
                                }
                              },
                              "items": {
                                "type": "object",
                                "properties": {
                                  "volumeName": {
                                    "type": "string",
                                    "description": "The name of the volume.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "Volume 名称。"
                                      }
                                    }
                                  },
                                  "type": {
                                    "type": "string",
                                    "description": "The category of the volume.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "Volume 的类别。"
                                      }
                                    }
                                  },
                                  "regionId": {
                                    "type": "string",
                                    "description": "The ID of the region where the volume is located.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "Volume 所属区域的 ID。"
                                      }
                                    }
                                  },
                                  "storageIntegrationId": {
                                    "type": "string",
                                    "description": "The storage integration ID. Only returned for external volumes.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "存储集成 ID。仅对外部 Volume 返回。"
                                      }
                                    }
                                  },
                                  "path": {
                                    "type": "string",
                                    "description": "The path prefix within the volume. Only returned for external volumes.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "存储卷内的路径前缀。仅对外部 Volume 返回。"
                                      }
                                    }
                                  },
                                  "status": {
                                    "type": "string",
                                    "description": "The current status of the volume.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "Volume 的当前状态。"
                                      }
                                    }
                                  },
                                  "createTime": {
                                    "type": "integer",
                                    "description": "The Unix timestamp when the volume was created.",
                                    "x-i18n": {
                                      "zh-CN": {
                                        "description": "Volume 创建时间的 Unix 时间戳。"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "failure",
                      "description": "Returns an error message.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回错误消息。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ],
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            }
                          }
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "错误描述。"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "1": {
                    "summary": "success",
                    "x-target-response": "OPTION 1",
                    "value": {
                      "code": 200,
                      "data": {
                        "count": 3,
                        "currentPage": 1,
                        "pageSize": 10,
                        "volumes": [
                          {
                            "volumeName": "my_volume_1",
                            "type": "MANAGED",
                            "regionId": "aws-us-west-2",
                            "status": "Running",
                            "createTime": 1704067200000
                          },
                          {
                            "volumeName": "my_volume_2",
                            "type": "EXTERNAL",
                            "regionId": "aws-us-west-2",
                            "storageIntegrationId": "si-123456",
                            "path": "/data",
                            "status": "Running",
                            "createTime": 1704153600000
                          },
                          {
                            "volumeName": "my_volume_3",
                            "type": "MANAGED",
                            "regionId": "ali-cn-hangzhou",
                            "status": "Running",
                            "createTime": 1704240000000
                          }
                        ]
                      }
                    }
                  },
                  "2": {
                    "summary": "failure",
                    "x-target-response": "OPTION 2",
                    "value": {
                      "code": 1800,
                      "message": "User hasn't authenticated"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/volumes/apply": {
      "post": {
        "summary": "Apply Volume",
        "description": "Applies a volume configuration, creating a temporary stage if no stage name is provided.",
        "x-i18n": {
          "zh-CN": {
            "summary": "应用存储卷",
            "description": "本接口用于应用存储卷配置。如果未提供存储卷名称，则会创建一个临时 Stage。"
          }
        },
        "tags": [
          "Volume Operations (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              }
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "Use `application/json`.",
            "required": false,
            "example": "application/json",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "使用 `application/json`。"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "volumeName": {
                    "type": "string",
                    "description": "Name of the volume.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "存储卷名称。"
                      }
                    }
                  },
                  "projectId": {
                    "type": "string",
                    "description": "ID of the project.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "项目 ID。"
                      }
                    }
                  },
                  "regionId": {
                    "type": "string",
                    "description": "ID of the cloud region.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "云地域 ID。"
                      }
                    }
                  },
                  "clusterId": {
                    "type": "string",
                    "description": "ID of the cluster.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "集群 ID。"
                      }
                    }
                  },
                  "path": {
                    "type": "string",
                    "description": "Path within the volume.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "存储卷内的路径。"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns details of the applied volume.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回已应用存储卷的详细信息。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "endpoint": {
                              "type": "string",
                              "description": "Endpoint of the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储卷端点。"
                                }
                              }
                            },
                            "cloud": {
                              "type": "string",
                              "description": "Cloud provider.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "云提供商。"
                                }
                              }
                            },
                            "region": {
                              "type": "string",
                              "description": "Cloud region.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "云地域。"
                                }
                              }
                            },
                            "bucketName": {
                              "type": "string",
                              "description": "Name of the bucket.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储桶名称。"
                                }
                              }
                            },
                            "remotePath": {
                              "type": "string",
                              "description": "Remote path of the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储卷的远程路径。"
                                }
                              }
                            },
                            "volumeName": {
                              "type": "string",
                              "description": "Name of the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储卷名称。"
                                }
                              }
                            },
                            "volumePrefix": {
                              "type": "string",
                              "description": "Prefix of the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储卷前缀。"
                                }
                              }
                            },
                            "uploadPath": {
                              "type": "string",
                              "description": "The upload path. Deprecated, use `remotePath` instead.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "上传路径。已弃用，请使用 `remotePath`。"
                                }
                              }
                            },
                            "condition": {
                              "type": "object",
                              "description": "Access conditions for the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "存储卷的访问条件。"
                                }
                              },
                              "properties": {
                                "maxContentLength": {
                                  "type": "integer",
                                  "description": "Maximum content length allowed.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "允许的最大内容长度。"
                                    }
                                  }
                                },
                                "maxFileNumber": {
                                  "type": "integer",
                                  "description": "Maximum number of files allowed.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "允许的最大文件数量。"
                                    }
                                  }
                                }
                              }
                            },
                            "credentials": {
                              "type": "object",
                              "description": "Temporary credentials for accessing the volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "访问存储卷的临时凭证。"
                                }
                              },
                              "properties": {
                                "tmpAK": {
                                  "type": "string",
                                  "description": "Temporary access key.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "临时访问密钥。"
                                    }
                                  }
                                },
                                "tmpSK": {
                                  "type": "string",
                                  "description": "Temporary secret key.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "临时私有密钥。"
                                    }
                                  }
                                },
                                "sessionToken": {
                                  "type": "string",
                                  "description": "Session token.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "会话令牌。"
                                    }
                                  }
                                },
                                "expireTime": {
                                  "type": "string",
                                  "description": "Expiration time of the credentials.",
                                  "x-i18n": {
                                    "zh-CN": {
                                      "description": "凭证过期时间。"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "description": "Response payload which contains the applied volume details.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应载荷，包含已应用存储卷的详细信息。"
                            }
                          }
                        }
                      }
                    },
                    {
                      "x-tab-label": "failure",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            }
                          }
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "错误描述。"
                            }
                          }
                        }
                      },
                      "description": "A failure response.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "失败响应。"
                        }
                      },
                      "x-i18n-langs": [
                        "zh-CN"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2/volumes/create": {
      "post": {
        "summary": "Create Volume",
        "deprecated": false,
        "description": "This operation creates a new volume in the specified project.",
        "x-i18n": {
          "zh-CN": {
            "summary": "创建 Volume",
            "description": "本接口用于在指定项目下创建一个新的 Volume。"
          }
        },
        "tags": [
          "Volume Operations (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be <include target=\"zilliz\">an API key with appropriate privileges or </include>a pair of colon-joined username and password, like `username:password`.",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string"
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为<include target=\"zilliz\">具备适当权限的 API 密钥或</include>用冒号分隔的用户名和密码，如 `username:password`。"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project to which the volume belongs.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "所属项目的 ID。"
                      }
                    },
                    "example": "proj-xxxxxxxxxxxxxxxxxxxxxxx"
                  },
                  "regionId": {
                    "type": "string",
                    "description": "The ID of the region where the volume will be created. You can use [List Cloud Regions](/reference/list-cloud-regions-v2) to list available regions.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "Volume 所属区域的 ID。您可以使用 [查看云服务区域](/reference/list-cloud-regions-v2) 接口列出可用区域。"
                      }
                    }
                  },
                  "volumeName": {
                    "type": "string",
                    "description": "The name of the volume to create.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "Volume 名称。"
                      }
                    }
                  },
                  "type": {
                    "type": "string",
                    "description": "The category of the volume. Valid values are `MANAGED` and `EXTERNAL`. Defaults to `MANAGED`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "Volume 的类别。有效值为 `MANAGED` 和 `EXTERNAL`。默认值为 `MANAGED`。"
                      }
                    }
                  },
                  "storageIntegrationId": {
                    "type": "string",
                    "description": "The storage integration ID. Required when `type` is `EXTERNAL`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "存储集成 ID。当 `type` 为 `EXTERNAL` 时必填。"
                      }
                    }
                  },
                  "path": {
                    "type": "string",
                    "description": "The path prefix within the volume. Required when `type` is `EXTERNAL`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "存储卷内的路径前缀。当 `type` 为 `EXTERNAL` 时必填。"
                      }
                    }
                  }
                },
                "required": [
                  "volumeName",
                  "regionId",
                  "projectId"
                ]
              },
              "examples": {
                "1": {
                  "summary": "success",
                  "x-target-response": "OPTION 1",
                  "x-target-lang": "en-US",
                  "value": {
                    "projectId": "proj-xxxxxxxxxxxxxxxxxxxxxxx",
                    "regionId": "aws-us-west-2",
                    "volumeName": "my_volume"
                  }
                },
                "2": {
                  "summary": "success",
                  "x-target-response": "OPTION 1",
                  "x-target-lang": "zh-CN",
                  "value": {
                    "projectId": "proj-xxxxxxxxxxxxxxxxxxxxxxx",
                    "regionId": "ali-cn-hangzhou",
                    "volumeName": "my_volume"
                  }
                },
                "3": {
                  "summary": "external",
                  "x-target-response": "OPTION 1",
                  "x-target-lang": "en-US",
                  "value": {
                    "projectId": "proj-xxxxxxxxxxxxxxxxxxxxxxx",
                    "regionId": "aws-us-west-2",
                    "volumeName": "my_external_volume",
                    "type": "EXTERNAL",
                    "storageIntegrationId": "si-123456",
                    "path": "/data"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the name of the created volume.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回已创建的 Volume 名称。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "x-tab-label": "success",
                      "description": "Returns the created volume name.",
                      "x-i18n": {
                        "zh-CN": {
                          "description": "返回已创建的 Volume 名称。"
                        }
                      },
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
                            "zh-CN": {
                              "description": "响应码。"
                            }
                          }
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "volumeName": {
                              "type": "string",
                              "description": "The name of the created volume.",
                              "x-i18n": {
                                "zh-CN": {
                                  "description": "已创建的 Volume 名称。"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
