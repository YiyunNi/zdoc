      {
        "block_id": "doxcnqIgUV9ZutWG1qS8L3vqPvf",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus.model.dense import NomicEmbeddingFunction\n\nef = NomicEmbeddingFunction(\n    model_name=\"nomic-embed-text-v1.5\", # Defaults to `mistral-embed`\n    api_key=\"NOMIC_API_KEY\" # Provide your Nomic API key\n)\n\ndocs = [\n    \"Artificial intelligence was founded as an academic discipline in 1956.\",\n    \"Alan Turing was the first person to conduct substantial research in AI.\",\n    \"Born in Maida Vale, London, Turing was raised in southern England.\",\n]\n\ndocs_embeddings = ef.encode_documents(docs)\n\n# Print embeddings\nprint(\"Embeddings:\", docs_embeddings)\n# Print dimension and shape of embeddings\nprint(\"Dim:\", ef.dim, docs_embeddings[0].shape)\n\n# Embeddings: [array([ 5.59997560e-02,  7.23266600e-02, -1.51977540e-01, -4.53491200e-02,\n#         6.49414060e-02,  4.33654800e-02,  2.26593020e-02, -3.51867680e-02,\n#         3.49998470e-03,  1.75571440e-03, -4.30297850e-03,  1.81274410e-02,\n#         ...\n#        -1.64337160e-02, -3.85437000e-02,  6.14318850e-02, -2.82745360e-02,\n#        -7.25708000e-02, -4.15563580e-04, -7.63320900e-03,  1.88446040e-02,\n#        -5.78002930e-02,  1.69830320e-02, -8.91876200e-03, -2.37731930e-02])]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# Dim: 768 (768,)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
