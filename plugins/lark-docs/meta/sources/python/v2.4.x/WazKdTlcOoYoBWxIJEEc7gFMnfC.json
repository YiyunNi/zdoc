      {
        "block_id": "Hgu5d9lkxo7ZbyxIQoScJ0a7nDp",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import MilvusClient\n\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# 1. Create a milvus client",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": true,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\nclient = MilvusClient(\n    uri=\"https://inxx-xxxxxxxxxxxx.api.gcp-us-west1.zillizcloud.com:19530\",\n    token=\"user:password\"\n)\n\n# 1. Prepare a privilege group\nclient.create_privilege_group(\n    group_name=\"my_privilege_group\"\n)\n\nclient.add_privileges_to_group(\n    group_name=\"my_privilege_group\",\n    privileges=[\"ListDatabases\", \"DescribeDatabase\"]\n) \n\n# 2. Create a role\nclient.create_role(role_name=\"read_only\")\n\n# 3. Grant privileges\nclient.grant_privilege_v2(\n    role_name=\"db_read_only\",\n    privilege=\"my_privilege_group\",\n    collection_name=\"*\"\n)\n\n# 4. Revoke privileges\nclient.rovke_privilege_v2(\n    role_name=\"db_read_only\",\n    privilege=\"my_privilege_group\",\n    collection_name=\"*\"\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
