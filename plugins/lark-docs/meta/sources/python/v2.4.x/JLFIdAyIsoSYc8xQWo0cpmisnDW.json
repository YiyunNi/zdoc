              }
            },
            {
              "text_run": {
                "content": "# 1. Create a milvus client",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": true,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\nclient = MilvusClient(\n    uri=\"http://localhost:19530\",\n    token=\"root:Milvus\"\n)\n\n# upsert properties\nproperty_keys = [\"mmap.enabled\", \"collection.ttl.seconds\"]\n\nclient.drop_collection_properties(\n    collection_name=\"collection_name\", \n    property_keys=property_keys\n",
