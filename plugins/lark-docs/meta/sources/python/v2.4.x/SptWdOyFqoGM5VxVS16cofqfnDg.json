      {
        "block_id": "doxcnNcmTaUFmLFVBZUMQbC8oYe",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus.model.dense import MistralAIEmbeddingFunction\n\nef = MistralAIEmbeddingFunction(\n    model_name=\"mistral-embed\", # Defaults to `mistral-embed`\n    api_key=\"MISTRAL_API_KEY\" # Provide your Mistral AI API key\n)\n\nqueries = [\"When was artificial intelligence founded\", \n           \"Where was Alan Turing born?\"]\n\nquery_embeddings = ef.encode_queries(queries)\n\nprint(\"Embeddings:\", query_embeddings)\nprint(\"Dim\", ef.dim, query_embeddings[0].shape)\n\n# Embeddings: [array([-0.04916382,  0.04568481,  0.03594971, ..., -0.02653503,\n#         0.02804565,  0.00600815]), array([-0.05938721,  0.07098389,  0.01773071, ..., -0.01708984,\n#         0.03582764,  0.00366592])]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
