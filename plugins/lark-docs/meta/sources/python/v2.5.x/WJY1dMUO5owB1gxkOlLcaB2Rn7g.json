      {
        "block_id": "LwSWdVH1voMZgxxM1wAc1sqgnUd",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import model\n\nmodel2vec_ef = Model2VecEmbeddingFunction(\n    model_source=\"minishlab/potion-base-8M\" # Specify the model source (loads from Hugging Face or local path)\n)\n\ndocs = [\n    \"Artificial intelligence was founded as an academic discipline in 1956.\",\n    \"Alan Turing was the first person to conduct substantial research in AI.\",\n    \"Born in Maida Vale, London, Turing was raised in southern England.\",\n]\n\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "docs_embeddings ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "=",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " model2vec_ef",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ".",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "encode_documents(docs)\n\n# Print embeddings\nprint(\"Embeddings:\", docs_embeddings)\n# Print dimension and shape of embeddings\nprint(\"Dim:\", model2vec_ef.dim, docs_embeddings[0].shape)\n\n# Embeddings: [array([ 0.02220882,  0.11436888, -0.15094341,  0.08149259,  0.20425692,\n#       -0.15727402, -0.25320682, -0.00669029,  0.03157463,  0.08974048,\n#       -0.00148778, -0.01803541,  0.00230828, -0.0137875 , -0.19242321,\n#       -0.01353845, -0.17632745,  0.03382885,  0.07306298,  0.0569298 ,\n# ...\n#       -4.66700038e-03,  9.53254756e-03,  1.12857306e-02, -2.91118585e-02,\n#       -7.29782460e-03, -2.15345751e-02, -4.13905866e-02,  3.70773636e-02,\n#        5.45082428e-02,  1.36436718e-02,  1.38598625e-02,  3.91175086e-03],\n#      dtype=float32)]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# Dim: 256 (256,)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
