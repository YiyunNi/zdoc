      {
        "block_id": "doxcnSSC80SsU186ZQkHwobhhq9",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus.model.dense import InstructorEmbeddingFunction\n\nef = InstructorEmbeddingFunction(\n    model_name=\"hkunlp/instructor-xl\", # Defaults to `hkunlp/instructor-xl`\n    query_instruction=\"Represent the question for retrieval:\",\n    doc_instruction=\"Represent the document for retrieval:\"\n)\n\nqueries = [\"When was artificial intelligence founded\", \n           \"Where was Alan Turing born?\"]\n\nquery_embeddings = ef.encode_queries(queries)\n\nprint(\"Embeddings:\", query_embeddings)\nprint(\"Dim\", ef.dim, query_embeddings[0].shape)\n\n# Embeddings: [array([ 1.21721877e-02,  1.88485277e-03,  3.01732980e-02, -8.10302645e-02,\n#        -6.13401756e-02, -3.98149453e-02, -5.18723316e-02, -6.76784338e-03,\n#        -6.59285188e-02, -5.38365729e-02, -5.13435388e-03, -2.49210224e-02,\n#        -5.74403182e-02, -7.03031123e-02,  6.63730130e-03, -3.42259370e-02,\n#        ...\n#        7.36595877e-03,  2.85532661e-02, -1.55952033e-02,  2.13342719e-02,\n#        1.51187545e-02, -2.82798670e-02,  2.69396193e-02,  6.16136603e-02],\n#        dtype=float32)]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# Dim 768 (768,)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
