      {
        "block_id": "doxcnl7M48NQnIidNwkkZHGoRFb",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus.model.dense import NomicEmbeddingFunction\n\nef = NomicEmbeddingFunction(\n    model_name=\"nomic-embed-text-v1.5\", # Defaults to `mistral-embed`\n    api_key=\"NOMIC_API_KEY\" # Provide your Nomic API key\n)\n\nqueries = [\"When was artificial intelligence founded\", \n           \"Where was Alan Turing born?\"]\n\nquery_embeddings = ef.encode_queries(queries)\n\nprint(\"Embeddings:\", query_embeddings)\nprint(\"Dim\", ef.dim, query_embeddings[0].shape)\n\n# Embeddings: [array([ 3.24096680e-02,  7.35473600e-02, -1.63940430e-01, -4.45556640e-02,\n#         7.83081050e-02,  2.64587400e-02,  1.35898590e-03, -1.59606930e-02,\n#        -3.33557130e-02,  1.05056760e-02, -2.35290530e-02,  2.23388670e-02,\n#         ...\n#         7.67211900e-02,  4.54406740e-02,  9.70459000e-02,  4.00161740e-03,\n#        -3.12805180e-02, -7.05566400e-02,  5.04760740e-02,  5.22766100e-02,\n#        -3.87878400e-02, -3.03649900e-03,  5.90515140e-03, -1.95007320e-02])]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# Dim 768 (768,)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
