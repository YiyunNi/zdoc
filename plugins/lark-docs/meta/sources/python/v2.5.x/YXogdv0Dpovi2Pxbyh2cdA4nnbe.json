        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import MilvusClient, Function, FunctionType\n\nschema = MilvusClient.create_schema()\n\nbm25_function = Function(\n    name=\"bm25_fn\",\n    input_field_names=[\"document_content\"],\n    output_field_names=\"sparse_vector\",\n    function_type=FunctionType.BM25,\n)\n\nschema.add_function(bm25_function)\n\n# Verify the function\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "bm25_function.verify(schema)",
                "text_element_style": {
                  "bold": false,
