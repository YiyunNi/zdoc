                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\n\n# Revoke insert privilege on a collection from a role\nclient.revoke_privilege(\n    role_name=\"readOnly\",\n    object_type=\"Collection\",\n    privilege=\"Insert\",\n    object_name=\"my_collection\"\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
