        "block_type": 2,
        "parent_id": "doxcnSMhA2sUK4dnNSKgxSQMVFT",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Why doesn't the row count match the number of entities inserted?",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "YUBpdF7VZoF1Z1xSFtTcuRHNnGg",
        "block_type": 2,
        "parent_id": "doxcnSMhA2sUK4dnNSKgxSQMVFT",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The data ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "you insert will undergo processing before it is finally saved. Initially, it will arrive",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " as data streams. Then, it will be stored in segments as entities. Milvus will select an appropriate growing segment to store ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "data in streams until it",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " reaches its upper limit and becomes sealed.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "doxcnpZjs3MIkVSXHrhYMLyJjub",
        "block_type": 2,
        "parent_id": "doxcnSMhA2sUK4dnNSKgxSQMVFT",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "However, ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "note that the displayed row count may not match the number of records inserted, as stream data is not included",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ".",
