      {
        "block_id": "doxcnH6THW09SCHxXXT4QTW1K7g",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import MilvusClient\n\nclient = MilvusClient(\n    uri=\"http://localhost:19530\",\n    token=\"root:Milvus\"\n)\n\n# Create a collection\nclient.create_collection(collection_name=\"test_collection\", dimension=5)\n\n# Create a partition\nclient.create_partition(\n    collection_name=\"test_collection\",\n    partition_name=\"partition_A\"\n)\n\n# Release partition before dropping\nclient.release_partitions(\n    collection_name=\"test_collection\",\n    partition_names=[\"partition_A\"]\n)\n\n# Drop the partition\nclient.drop_partition(\n    collection_name=\"test_collection\",\n    partition_name=\"partition_A\"\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ")",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 49,
