                "content": "1",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\n}\ntransfer_from {\n  resource_group: \"__default_resource_group\"\n}\ntransfer_to {\n  resource_group: \"__default_resource_group\"\n}\n>,\n<nodes:[NodeInfo: # node detailed info\n<node_id: 1>,\n<address:ip:port>,\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
