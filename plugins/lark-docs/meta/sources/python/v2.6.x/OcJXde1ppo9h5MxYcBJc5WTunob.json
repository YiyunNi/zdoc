      {
        "block_id": "ZieAdLsqeoDdkuxUwC9cGiSZnrf",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import (\n    MilvusClient,\n    DataType,\n)\nfrom pymilvus.client.constants import DEFAULT_RESOURCE_GROUP\n\nfrom pymilvus.client.types import (\n    ResourceGroupConfig,\n)\n\ncollection_name = \"hello_milvus\"\nclient = MilvusClient(\"http://localhost:19530\")\n\n## create resource group\nprint(\"create resource group\")\nclient.create_resource_group(\"rg1\", config=ResourceGroupConfig(\n                requests={\"node_num\": 1},\n                limits={\"node_num\": 1},\n                transfer_from=[{\"resource_group\": DEFAULT_RESOURCE_GROUP}],\n                transfer_to=[{\"resource_group\": DEFAULT_RESOURCE_GROUP}],\n            ))\n\n## describe resource group\nprint(\"describe rg1\")\nresult = client.describe_resource_group(\"rg1\")\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "print(result)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
