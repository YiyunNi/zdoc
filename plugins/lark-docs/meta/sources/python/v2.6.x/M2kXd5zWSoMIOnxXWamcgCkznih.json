                }
              }
            },
            {
              "text_run": {
                "content": "# 1. Create a milvus client",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": true,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\nclient = MilvusClient(\n    uri=\"http://localhost:19530\",\n    token=\"root:Milvus\"\n)\n\nclient.drop_index_properties(\n    collection_name=\"collection_name\",\n    index_name=\"my_vector\", \n    property_keys = [\"mmap.enabled\"]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
