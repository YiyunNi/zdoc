      {
        "block_id": "BboGds5AjoWOdqxMwbhcziMPngd",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import DataType, FieldSchema, StructFieldSchema\n\nvector = FieldSchema(\n    name=\"vector_02\",\n    dtype=DataType.FLOAT_VECTOR,\n    dim=768,\n)\n\nvarchar = FieldSchema(\n    name=\"varchar_02\",\n    dtype=DataType.VARCHAR,\n    max_length=512\n)\n\n# Create dictionary representation \nschema_dict = {\n    \"fields\": [     \n        vector.to_dict(),\n        varchar.to_dict()                \n    ]\n}  \n\n# Reconstruct schema from dictionary \nschema = StructFieldSchema(name=\"struct_schema\", fields=[vector]).construct_from_dict(schema_dict)  \n\nprint(schema)\n\n# Output\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "# {'auto_id': False, 'description': '', 'fields': [{'name': 'id', 'description': '', 'type': <DataType.INT64: 5>, 'is_primary': True, 'auto_id': False}, {'name': 'vector', 'description': '', 'type': <DataType.FLOAT_VECTOR: 101>, 'params': {'dim': 768}}]}",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
