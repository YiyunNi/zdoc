      {
        "block_id": "BKgMdwVLXobQm4xnGnlclphun6i",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import (\n    MilvusClient,\n    DataType,\n)\nfrom pymilvus.client.constants import DEFAULT_RESOURCE_GROUP\n\nfrom pymilvus.client.types import (\n    ResourceGroupConfig,\n)\n\nclient = MilvusClient(\"http://localhost:19530\")\n\n## create resource group\nprint(\"create resource group\")\nclient.create_resource_group(\"rg1\", config=ResourceGroupConfig(\n                requests={\"node_num\": 1},\n                limits={\"node_num\": 1},\n                transfer_from=[{\"resource_group\": DEFAULT_RESOURCE_GROUP}],\n                transfer_to=[{\"resource_group\": DEFAULT_RESOURCE_GROUP}],\n            ))\n\n## drop resource group\nprint(\"drop resource group\")\n# create resource group\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "configs = {",
                "text_element_style": {
                  "bold": false,
                  "comment_ids": [
                    "7460470471704887300"
                  ],
                  "inline_code": false,
                  "italic": false,
