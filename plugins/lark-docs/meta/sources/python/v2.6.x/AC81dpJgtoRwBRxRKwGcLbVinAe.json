                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "            \"rg1\": ResourceGroupConfig(",
                "text_element_style": {
                  "bold": false,
                  "comment_ids": [
                    "7460470471704887300"
                  ],
                  "inline_code": false,
                  "italic": false,
