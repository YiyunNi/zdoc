      {
        "block_id": "Y04rddzMbotGoKx2OwscEQdznSh",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import StructFieldSchema, FieldSchema, DataType  \n\nvector = FieldSchema(\n    name=\"vector\",\n    dtype=DataType.FLOAT_VECTOR,\n    dim=768,\n)\n\nvarchar = FieldSchema(\n    name=\"varchar\",\n    dtype=DataType.VARCHAR,\n    max_length=512\n)\n\n# Create a StructFieldSchema with field schemas\n\nschema = StructFieldSchema(\n    name=\"struct_schema\",\n    fields = [vector, varchar]\n)\n\n# Call to_dict() to get a dictionary representation of the schema \n\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "schema_dict = schema.to_dict()  ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 49,
            "wrap": false
          }
        },
