      },
      {
        "block_id": "MGHEd0ewxofblTxQ2aacdJInnRf",
        "block_type": 2,
        "parent_id": "MYEfdVf1AohLOOx7LTdcpdy3nLc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "To optimize resource utilization, you can create additional resource groups, reassign specific query nodes from the default group, and load collections into these newly configured groups. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
