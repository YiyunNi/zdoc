        "parent_id": "MYEfdVf1AohLOOx7LTdcpdy3nLc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "This approach ensures that collections are allocated dedicated query nodes, enabling efficient and isolated search services.",
