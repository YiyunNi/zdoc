        "text": {
          "elements": [
            {
              "text_run": {
                "content": "A Milvus instance begins with a default resource group that includes all available query nodes. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
