        "text": {
          "elements": [
            {
              "text_run": {
                "content": "This operation manually seals a segment and persists the data on disk. It is recommended that this operation be called after all the data has been inserted into a collection. This is the synchronous function that ensures the flush operation is complete before the function returns.",
