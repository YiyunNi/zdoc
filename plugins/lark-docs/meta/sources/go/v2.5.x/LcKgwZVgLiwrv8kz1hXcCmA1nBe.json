        "text": {
          "elements": [
            {
              "text_run": {
                "content": "A Milvus instance begins with a default resource group that includes all available query nodes.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "JVf9deUwmoT9oYxIifGcYNG9nxg",
        "block_type": 2,
        "parent_id": "OV77db8GAopUdrxkg9UcROcMnTh",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "To optimize resource utilization, you can create additional resource groups, reassign specific query nodes from the default group, and load collections into these newly configured groups.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "FiqhdVMASov026xtJtVcjdxYnBg",
        "block_type": 2,
        "parent_id": "OV77db8GAopUdrxkg9UcROcMnTh",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "This approach ensures that collections are allocated dedicated query nodes, enabling efficient and isolated search services.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
