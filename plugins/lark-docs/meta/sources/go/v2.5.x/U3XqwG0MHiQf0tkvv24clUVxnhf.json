          "elements": [
            {
              "text_run": {
                "content": "rs, err := cli.Get(ctx, milvusclient.NewQueryOption(\"quick_setup\").\n        WithIDs(column.NewColumnInt64(\"id\", []int64{1, 2, 3})))\nif err != nil {\n    // handle error\n}\n\n",
