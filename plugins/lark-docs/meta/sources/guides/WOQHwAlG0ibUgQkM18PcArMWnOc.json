        "parent_id": "VCfRd0GbBoLgtSx2xIHcQsrmnmf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "You can enable these API services on the GCP console or using the gcloud CLI by referring to ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
