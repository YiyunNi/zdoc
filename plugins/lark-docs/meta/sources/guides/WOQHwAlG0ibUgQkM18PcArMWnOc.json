              "text_run": {
                "content": "this document",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fcloud.google.com%2Fendpoints%2Fdocs%2Fopenapi%2Fenable-api%23enabling_an_api"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " for detailed procedures. To enable the above-listed API services using the gcloud CLI, do as follows:",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "M0dfdBaXBoviduxQZScc4Xzbntf",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "gcloud services enable \\\n  compute.googleapis.com \\\n  container.googleapis.com \\\n  storage.googleapis.com \\\n  iam.googleapis.com \\\n  servicenetworking.googleapis.com \\\n  cloudresourcemanager.googleapis.com \\\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "  --project=PROJECT_ID",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 60,
