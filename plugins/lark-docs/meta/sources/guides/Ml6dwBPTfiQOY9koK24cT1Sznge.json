              "text_run": {
                "content": "curl --request DELETE \\\n     --url \"${BASE_URL}/v2/clusters/${CLUSTER_ID}/backups/${BACKUP_ID}\" \\\n     --header \"Authorization: Bearer ${TOKEN}\" \\\n     --header \"Accept: application/json\" \\\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "     --header \"Content-type: application/json\"",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
