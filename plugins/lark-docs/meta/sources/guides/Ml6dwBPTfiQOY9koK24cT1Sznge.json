                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " are deleted automatically after their retention period ends or when the associated cluster is deleted. You can also delete them manually at any time.",
