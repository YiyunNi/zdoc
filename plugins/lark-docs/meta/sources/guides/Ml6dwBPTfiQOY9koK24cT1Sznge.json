        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Manual backups",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " are retained permanently, even if the cluster is deleted. To reduce costs, it is recommended to manually delete backups when they are no longer needed.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
