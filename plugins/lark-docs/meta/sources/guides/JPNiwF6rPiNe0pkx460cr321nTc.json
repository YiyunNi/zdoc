        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Consistency across historical data and real-time updates,",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
