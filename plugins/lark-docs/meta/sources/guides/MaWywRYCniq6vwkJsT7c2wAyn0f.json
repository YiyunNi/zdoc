        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The ARRAY operators allow for fine-grained querying of array fields in <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud clusters</include>. These operators are:",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
