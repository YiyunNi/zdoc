        "block_type": 2,
        "parent_id": "H1DWdVmsroJYKVxa7GPc2H3lnSd",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The following example restores a full cluster for an existing backup file to a new cluster named ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Dedicated-01-backup",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ". For details about the RESTful API, see ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Restore Cluster Backup",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fdocs.zilliz.com%2Freference%2Frestful%2Frestore-cluster-backup-v2"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ".",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "ACjWdCVLboAYpaxSSLgcQuJvncb",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "curl --request POST \\\n     --url \"${BASE_URL}/v2/clusters/${CLUSTER_ID}/backups/${BACKUP_ID}/restoreCluster\" \\\n     --header \"Authorization: Bearer ${TOKEN}\" \\\n     --header \"Accept: application/json\" \\\n     --header \"Content-type: application/json\" \\\n     --data-raw '{\n        \"targetProjectId\": \"proj-20e13e974c7d659a83xxxx\",\n        \"clusterName\": \"Dedicated-01-backup\",\n        \"cuSize\": 1,\n        \"collectionStatus\": \"KEEP\"\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "      }'",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 7,
            "wrap": false
          }
        },
        "parent_id": "H1DWdVmsroJYKVxa7GPc2H3lnSd"
