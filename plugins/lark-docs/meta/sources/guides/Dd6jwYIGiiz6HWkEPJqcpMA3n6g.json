        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "curl --request POST \\\n--url \"${BASE_URL}/v2/clusters/${CLUSTER_ID}/backups/${BACKUP_ID}/restoreCollection\" \\\n--header \"Authorization: Bearer ${TOKEN}\" \\\n--header \"Content-Type: application/json\" \\\n-d '{\n    \"destClusterId\": \"in01-xxxxxxxxxxxxxx\",\n    \"dbCollections\": [\n        {\n            \"collections\": [\n                {\n                    \"collectionName\": \"medium_articles\",\n                    \"destCollectionName\": \"restore_medium_articles\",\n                    \"destCollectionStatus\": \"LOADED\"\n                }\n            ]\n        }\n    ]\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
