      },
      {
        "block_id": "YFund2MUooFVjIxZE0scJyt6nSg",
        "block_type": 4,
        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "How is the token processed by Pipelines?",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc"
      },
      {
        "block_id": "DccWd3gO3ow2RwxOpXCc4DJsnkd",
        "block_type": 2,
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Ingestion Pipeline",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " processes documents by parsing files into tokens and then splitting and embedding the token series. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Search Pipeline",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " processes the query by embedding the token series. By passing the tokens to a deep learning model (called embedding model), the \"essence\" of the text is converted into a vector representation, which can be stored in and retrieved by a vector database. With the help of this process, Pipelines is able to help the API users to understand the meaning and semantics of different words and their context within a sentence or text.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "I761dnKZUoSdNQxwf1Icg6PMn1d",
        "block_type": 2,
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Deletion",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " Pipelines usually doesn't involve processing text as tokens.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
