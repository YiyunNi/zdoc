      {
        "block_id": "OZEjdUwWZocaALxjJMJcZ0WinMc",
        "block_type": 2,
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The cost of running pipelines is measured by tokens. Similar to Large Language Model (LLM) that uses token as a basic unit, pipelines process documents and search queries by parsing and embedding the text as a series of tokens. To understand the cost of a pipeline run, you can use our Estimate Pipeline Usage tool to count tokens of a file or a text string. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
