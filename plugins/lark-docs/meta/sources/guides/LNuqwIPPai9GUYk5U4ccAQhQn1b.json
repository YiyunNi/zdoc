      {
        "block_id": "XWbad4iv4o5dGOxf47rc6Qwunah",
        "block_type": 4,
        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "What are tokens?",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc"
      },
      {
        "block_id": "TmHRdP0fzozroXxYnWFcyXtUnRE",
        "block_type": 2,
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Token is a special concept in NLP. It can be thought of as a sub-word. Some word is a token itself, while some longer words may contain multiple tokens. Token is also language dependent. As a rule of thumb, on average:",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "PWkWd1s63o0pyHxgesZcWYALnbf",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "1 token is 3 to 4 English characters",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "YHYAdOpGroLFHFx8qPdcOE95ntc"
      },
      {
        "block_id": "I6sJdfez4oPCodxWoTAcP5QLnAf",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "1 token is 1.12 Chinese characters",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
