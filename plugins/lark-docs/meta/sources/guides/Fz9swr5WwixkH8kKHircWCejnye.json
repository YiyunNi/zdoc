        "text": {
          "elements": [
            {
              "text_run": {
                "content": "To calculate a search's recall rate, you can divide the number of relevant items retrieved by the total number of applicable items that should be retrieved. For example, if a search retrieves 90 of 100 relevant items, the recall rate should be ",
