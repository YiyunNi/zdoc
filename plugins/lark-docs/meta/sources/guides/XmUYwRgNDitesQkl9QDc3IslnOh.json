        "parent_id": "TAEedr1hho6UpjxGHhBcn9nFnbf"
      },
      {
        "block_id": "Bm22dFHWqoMvcIxCiKWcKRJWnF7",
        "block_type": 2,
        "parent_id": "Jy7pdQNX1o3WbyxlMTscRLranUf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "We are pleased to announce that Zilliz Cloud is now available on Google Cloud Platform (GCP). Zilliz Cloud offers the best experience and meets the diverse requirements of various users, ranging from startups to large enterprises. You can deploy managed vector database instances on GCP with just a few clicks.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "HalUdEMPdoeUTDxMXwxcSg0BnTg",
        "block_type": 2,
        "parent_id": "Jy7pdQNX1o3WbyxlMTscRLranUf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The us-west1 region (The Dalles, Oregon) is now available. The cost per CU for our services on GCP is $0.215 per hour for both performance-optimized and capacity-optimized types, and the storage cost is $0.02/GB per month.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "PFevdrzDhoKAP3x7PY8cXTwCnJe",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "AWS Marketplace",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
