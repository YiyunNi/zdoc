      {
        "block_id": "doxcn4ZOUnIM8C5AAko4qrIGRMg",
        "block_type": 2,
        "parent_id": "TAEedr1hho6UpjxGHhBcn9nFnbf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "We are pleased to announce the general availability of a significant update to Zilliz Cloud. This release raises the standard of vector database services for usability, security, performance, and capability to a new stage, bringing you a state-of-the-art vector database experience built for everyone.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "ORUydvNiHoMXJSxFWaZccNmNnWh",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Billion-scale Vector Collection Support",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "ANS7dhOTIoOnnZxHWmqc369AnSb",
          "FG4FdHsRpotT1OxxVmZcWY5dnOh"
        ],
        "parent_id": "TAEedr1hho6UpjxGHhBcn9nFnbf"
      },
      {
        "block_id": "ANS7dhOTIoOnnZxHWmqc369AnSb",
        "block_type": 2,
        "parent_id": "ORUydvNiHoMXJSxFWaZccNmNnWh",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "With this release, Zilliz Cloud has pushed the capacity limit of vector databases to a billion-scale. Now enterprise users can create ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "32 CU database instances",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliz.com%2Fpricing"
                  },
                  "strikethrough": false,
                  "underline": true
                }
              }
            },
            {
              "text_run": {
                "content": " (for both performance-optimized CU and capacity-optimized CU) through the Zilliz Cloud web interface.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "FG4FdHsRpotT1OxxVmZcWY5dnOh",
        "block_type": 2,
        "parent_id": "ORUydvNiHoMXJSxFWaZccNmNnWh",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "For users who require larger instances for PoC or production deployment, please don’t hesitate to ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "contact us",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliz.com%2Fcontact-sales"
                  },
                  "strikethrough": false,
                  "underline": true
                }
              }
            },
            {
              "text_run": {
                "content": " to obtain instances up to 256 performance-optimized CUs (which can serve 1.3 billion 128-dimensional vectors) or 128 capacity-optimized CUs (which can serve 3 billion 128-dimensional vectors).",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "RiscdofzOo3UyrxqqGUcER5Gnhb",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Performance Improvements",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "OmsQd9tYYo1s00xIMDacKAklnRh",
          "PaVndbNGXokXHkx8Vo7cghb0nTf",
          "XP0Gdmy27oqGvOxkfT3co5eZnEh"
        ],
        "parent_id": "TAEedr1hho6UpjxGHhBcn9nFnbf"
      },
      {
        "block_id": "OmsQd9tYYo1s00xIMDacKAklnRh",
        "block_type": 2,
        "parent_id": "RiscdofzOo3UyrxqqGUcER5Gnhb",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "This updated version of Zilliz Cloud is built based on Milvus 2.2.3. With Milvus 2.2.3, we achieved a 2.5x reduction in search latency compared to the original Milvus 2.0.0 release. Lower latency benefits all users but is key when dealing with real-time information retrieval systems such as recommendation systems, image/video/text search, and question answering.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "PaVndbNGXokXHkx8Vo7cghb0nTf",
        "block_type": 2,
        "parent_id": "RiscdofzOo3UyrxqqGUcER5Gnhb",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Our testing under an identical environment showed a 4.5x increase in QPS with Milvus 2.2.3 compared to 2.0.0. Due to this increase, Milvus is now even more hardware and cost-efficient, which is critical in building large-scale vector search platforms.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "XP0Gdmy27oqGvOxkfT3co5eZnEh",
        "block_type": 2,
        "parent_id": "RiscdofzOo3UyrxqqGUcER5Gnhb",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "For more details, please see our ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "white paper",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliz.com%2Fresources%2Fmilvus-performance-benchmark"
                  },
