        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud on GCP",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
