        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud now includes a database layer positioned between clusters and collections, offering an efficient way to manage and organize data while enabling multi-tenancy. In this structure, a database is a logical unit for organizing and managing data. Users can create multiple databases to logically isolate data across different applications or tenants to enhance data security and enable multi-tenancy. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Learn more about databases",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fdocs.zilliz.com%2Fdocs%2Fdatabase"
