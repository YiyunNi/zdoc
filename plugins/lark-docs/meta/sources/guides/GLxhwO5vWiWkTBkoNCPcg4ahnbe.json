      },
      {
        "block_id": "N5l5d4tH5oNc26xGudgcO0SmnNc",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Customer-managed encryption keys are managed at the project level. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "QHPsdJ4UkoxpdTxt6S1clHqsnuf"
      },
      {
        "block_id": "KBAddbGkio02WQxbhHlccR4ZnX7",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "You can add up to 20 unique keys to each project. Adding duplicate keys will cause failures.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "QHPsdJ4UkoxpdTxt6S1clHqsnuf"
      },
      {
        "block_id": "ZSWQdYRatoXPD1x7MUFcaWsEnzh",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Once a cluster is encrypted, migrating collections across databases is prohibited.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "QHPsdJ4UkoxpdTxt6S1clHqsnuf"
      },
      {
        "block_id": "IvU0djavZo19FKx3iujcUhWennc",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Always ensure that the cloud provider and region of a KMS key match those of the Zilliz Cloud cluster using that key.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "QHPsdJ4UkoxpdTxt6S1clHqsnuf"
      },
      {
        "block_id": "P9kVdwnQfoADzkxLjHCcjxI1nLb",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "To enable CMEK on existing clusters compatible with Milvus v2.5.x, back up the data and restore it to a new cluster compatible with Milvus v2.6.x.  Upgrading clusters does not encrypt data prior to the upgrade. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
