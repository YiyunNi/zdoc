      {
        "block_id": "P8ZXdagTRoURI6xJsbhcr5I6nXF",
        "block_type": 2,
        "parent_id": "W5K1dncIsoKR9dxj7V0cWPuNn4g",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Currently, CMEK is available only in AWS regions. For other regions, please ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "contact us",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fsupport.zilliz.com%2Fhc%2Fen-us"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ".",
