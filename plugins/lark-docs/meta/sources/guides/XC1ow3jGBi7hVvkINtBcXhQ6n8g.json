      },
      {
        "block_id": "Bi7Zdycslodr23xrjH7cm5X7nFe",
        "block_type": 2,
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Milvus implements a manifest-based snapshot architecture for efficient point-in-time capture, storage, and restoration of data without duplicating the actual vector data. The architecture separates metadata management from physical data storage, enabling lightweight snapshots that reference existing segment files in object storage.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "K0UXdiiUaoyOfaxmb0McbYSMnKd",
        "block_type": 2,
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "When you create a snapshot for a collection, Milvus collects the following:",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "RcRRdpEfqomSTRx28r5ciTxlnNh",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Snapshot metadata",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "TUEmdJ33RoIa3cxfwxvcmr03ngf"
        ],
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "TUEmdJ33RoIa3cxfwxvcmr03ngf",
        "block_type": 2,
        "parent_id": "RcRRdpEfqomSTRx28r5ciTxlnNh",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "It provides basic information for creating the snapshot, including the snapshot name and description, the target collection ID, and the time point at which the snapshot is created.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "ZR2SdbJTSoHkG6xqrZ2cIleTn1g",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Collection description",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "HaRGdDtnVo3feDxTUhNc7Z8jnde"
        ],
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "HaRGdDtnVo3feDxTUhNc7Z8jnde",
        "block_type": 2,
        "parent_id": "ZR2SdbJTSoHkG6xqrZ2cIleTn1g",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "It contains the description of the target collection, including its schema definition, partition information, and properties.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "WGREdIGe1oytsnxUS39cpCnwnnf",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Index information",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "RZirdIU0DoH2mfxFWYJcZ92qnIf"
        ],
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "RZirdIU0DoH2mfxFWYJcZ92qnIf",
        "block_type": 2,
        "parent_id": "WGREdIGe1oytsnxUS39cpCnwnnf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "It stores the index metadata and the paths to index files.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "VoELd9iWmoU699xqX6zcqpuonug",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Segment data",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "FT1TdPA7hoJ174xqFy9cvn8Jnof"
        ],
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "FT1TdPA7hoJ174xqFy9cvn8Jnof",
        "block_type": 2,
        "parent_id": "VoELd9iWmoU699xqX6zcqpuonug",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "It captures the vector data files (binlogs), deletion logs (deltalogs), and index files.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "AwQudWxnRok531xRnVvcIFjcnsc",
        "block_type": 2,
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Among the above information, Milvus generates an Apache Avro manifest file for each segment and stores the snapshot metadata, collection description, index information, and the paths to the manifest files in a JSON file. The following diagram illustrates the snapshot folder structure.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "INFodYuqDoo601xRXwXcGIXynAc",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "snapshots/{collection_id}/\n├── metadata/\n│   └── {snapshot_id}.json         # Snapshot metadata (JSON format)\n│\n└── manifests/\n    └── {snapshot_id}/             # Directory for each snapshot\n        ├── {segment_id_1}.avro    # Individual segment manifest (Avro format)\n        ├── {segment_id_2}.avro\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "        └── ...",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 49,
            "wrap": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "ATXddtbH8oBrkhx1QnIcl1OBn7y",
        "block_type": 2,
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Creating a snapshot usually takes milliseconds, and restoring it takes seconds to minutes, depending on the data volume. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "MWbkd0zzzottJBx5WSAcALVsnUc",
        "block_type": 4,
        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "Storage impacts and considerations",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "F8TndiFQxobPSLxEeZVcM5PQncd",
        "block_type": 2,
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Once Milvus references a segment or index file in a snapshot, it does not garbage-collect those files unless you drop the snapshot. Snapshots consume storage proportional to the size of the target collections, and object storage costs apply to snapshot retention. In extreme cases, a single snapshot can even double your object storage costs. You are advised to",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "Xr5zdqCKroFkb1xnguyc8sZinLx",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Remove old snapshots regularly to save storage. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "HggHdzlVZo9IAkxA44HcNXILnQh",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Use descriptive names and descriptions for future reference. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "EnKSd7bIOo0TlqxWXzQcOqvynRa",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Always verify snapshot creation and restoration results. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
      },
      {
        "block_id": "Hc4YdyBAUo2euaxtXKUcZVg0nxb",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Track snapshot creation timestamps, storage usage, and ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "PsGYdbK0zoGXbAxlBEGcigWDn0d"
