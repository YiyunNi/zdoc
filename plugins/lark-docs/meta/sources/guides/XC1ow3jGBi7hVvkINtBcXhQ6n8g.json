      },
      {
        "block_id": "D2ZwduSimo930nxWm0ScaW1QnMb",
        "block_type": 2,
        "parent_id": "U25pd57cRoeV9cxpXLlc5vh7nXc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Snapshots are quick, point-in-time images of data, suitable for fast rollbacks or testing (",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "days to weeks",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "). At the same time, backups are independent, complete copies stored separately for long-term disaster recovery (",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "weeks to years",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ") and for better protection against total storage failure. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
