        "parent_id": "WUatdCRRioHVnKxOUrwc6k5hn0J",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The latest Zilliz Cloud update introduces a range of enhancements, including support for larger standard vector databases, streamlined management of collections and indexes directly from the Cloud UI, and the ability to execute vector searches within the same interface. For enhanced security, database access from the Internet is now disabled by default, with an improved whitelisting experience to manage access. The platform also introduces a credit system and further refines the Cloud UI for more intuitive interaction. Under the hood, the internal system has been optimized for greater stability and performance.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
