                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " on Google Cloud Platform (GCP). This latest release enables our users to easily backup and restore their databases on GCP, ensuring data recovery and business continuity.",
