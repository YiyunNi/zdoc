        "parent_id": "INVidpiyDoaoQGxCxwWcK0ALnKe"
      },
      {
        "block_id": "HgtUdTVVtoli7Axfh1EcjfMPnGf",
        "block_type": 2,
        "parent_id": "EV5Xd80PFo3SpzxTIUXcuN08nNd",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "We are excited to announce the launch of our new feature - Pricing Calculator. This new feature is designed to help our users plan and estimate their costs effectively. With the Pricing Calculator, users can easily select their CU type, enter their number of entities and vector dimensions, and get recommended CU size and cost estimates of Zilliz Cloud. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Click here",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliz.com%2Fpricing%23calculator"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " to try it out.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "BQZDdS8eeoFbmjxMZIOcRQ07nGd",
        "block_type": 2,
        "parent_id": "EV5Xd80PFo3SpzxTIUXcuN08nNd",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Our Pricing Calculator only supports vector data now, and we plan to expand its capabilities to include scalar data in the future, providing even more accurate cost estimates for our users.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
