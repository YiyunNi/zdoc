      {
        "block_id": "YHl4deJEGoABMGxYQNicgwRCnjh",
        "block_type": 2,
        "parent_id": "INVidpiyDoaoQGxCxwWcK0ALnKe",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "We're thrilled to unveil the newest Zilliz Cloud update, featuring a pricing calculator for cost estimation, a data backup and restore process for enhanced data security, a customizable timezone setting for global users, a collection rename tool for better organization, the removal of storage quotas for unrestricted usage, and improved credit conservation for inactive databases.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "EV5Xd80PFo3SpzxTIUXcuN08nNd",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Pricing Calculator",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "HgtUdTVVtoli7Axfh1EcjfMPnGf",
