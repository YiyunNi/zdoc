      {
        "block_id": "DBQ9dqGYWoUXPgxFBbzcT8rxnJe",
        "block_type": 2,
        "parent_id": "F89zdOHW1oXwoexvcS6c5n8MntR",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud now supports cluster-level access control, enabling granular permission management within projects. Administrators can assign distinct roles to individual clusters and volumes, enforcing strict resource isolation without ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "splitting",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " projects.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "AY2RdNqtGoPoXZxLiF1cZdQVnbe",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Per-Cluster Role Assignment:",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " Grants independent roles (ReadOnly / ReadWrite) to individual clusters and volumes within the same project, allowing fine-grained separation of duties across environments and workloads.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "F89zdOHW1oXwoexvcS6c5n8MntR"
      },
      {
        "block_id": "DH5udsneyo2BmfxJRDSciRBync1",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Strict Access Enforcement:",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " API requests to unauthorized resources are rejected, and restricted resources are hidden from the Console. All access is strictly scoped to the user's granted permissions.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "F89zdOHW1oXwoexvcS6c5n8MntR"
      },
      {
        "block_id": "Wtj2dsGb6os9knxdA6gcqevHntg",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Seamless Migration:",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " Existing users are automatically migrated with \"All Resources\" access, preserving their current project roles. No manual action is required.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
