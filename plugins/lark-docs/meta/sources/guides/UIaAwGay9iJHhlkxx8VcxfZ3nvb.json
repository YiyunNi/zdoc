      {
        "block_id": "doxcnbEXRWxpAtH2rO5ZuZAmyMx",
        "block_type": 2,
        "parent_id": "GE8tdn29boPA8GxeS21ctiaPnVk",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "We are pleased to announce the general availability of a significant update to Zilliz Cloud. This release adds the data preview feature and a demo dataset that can be easily imported into your collection on the console.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "KIlodx8tsokEtoxrH8gcZN4Dnfy",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Data preview",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "IgjDdXRE8obRN2xskA6cuOr2nXc",
          "QgvYdM3E5o7n6PxPel6c1cNnnTd"
        ],
        "parent_id": "GE8tdn29boPA8GxeS21ctiaPnVk"
      },
      {
        "block_id": "IgjDdXRE8obRN2xskA6cuOr2nXc",
        "block_type": 2,
        "parent_id": "KIlodx8tsokEtoxrH8gcZN4Dnfy",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "In this release, Zilliz Cloud offers a data preview capability. You can find the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Data Preview",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " feature tab on each collection page. The preview table lets you view all the values of a set of sampled entities in a collection, which makes it easy to verify your data.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "QgvYdM3E5o7n6PxPel6c1cNnnTd",
        "block_type": 2,
        "parent_id": "KIlodx8tsokEtoxrH8gcZN4Dnfy",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Along with the data preview capabilities, you can select any of the vectors in the preview table and use them as the query vector. This allows you to quickly verify the neighboring data in your collection.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "PbNmdaQ6zowV1LxshATcD8Wdndg",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Demo dataset",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "children": [
          "KvVPdpme4oUjM7x7Hd5cScDXnlc",
          "YIQZdPxNGosRzWxpTXbcKCuUnqd"
        ],
        "parent_id": "GE8tdn29boPA8GxeS21ctiaPnVk"
      },
      {
        "block_id": "KvVPdpme4oUjM7x7Hd5cScDXnlc",
        "block_type": 2,
        "parent_id": "PbNmdaQ6zowV1LxshATcD8Wdndg",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud now provides a demo dataset to help beginners get familiar with the functionalities of vector databases. The demo dataset is derived from a Kaggle dataset. It contains details of over 5,000 articles published between Jan 2020 to August 2020 in prominent publications.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "YIQZdPxNGosRzWxpTXbcKCuUnqd",
        "block_type": 2,
        "parent_id": "PbNmdaQ6zowV1LxshATcD8Wdndg",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Now, you can experience the whole set of vector database functionalities easily, with no extra effort needed for data preparation. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "Enjoy it!",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fcloud.zilliz.com%2Fsignup"
                  },
                  "strikethrough": false,
                  "underline": true
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      }
