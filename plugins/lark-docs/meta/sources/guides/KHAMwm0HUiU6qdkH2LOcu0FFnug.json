        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Authentication verifies your identity when you sign in to Zilliz Cloud. To strengthen this process, Zilliz Cloud supports multi-factor authentication (MFA).",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "NqSgdWD8Hoqs0DxvptFcw8bmnfg",
        "block_type": 2,
        "parent_id": "HE1DdqSMWoslMCx5jiLc9mqTn0g",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "With MFA enabled, you must provide two factors at login:",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "Vn31dFJg0oeoxNxUfF7c2yEVnoc",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Your account password",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "HE1DdqSMWoslMCx5jiLc9mqTn0g"
      },
      {
        "block_id": "SLeqd0yxNoQN1BxUyEBclIAnnbd",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "A TOTP (time-based one-time password) from an authenticator app (Eg. Google Authenticator, Microsoft Authenticator, etc.)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
