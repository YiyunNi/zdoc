        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Login method compatibility",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ": The built-in Zilliz Cloud MFA feature is only available to users who ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
