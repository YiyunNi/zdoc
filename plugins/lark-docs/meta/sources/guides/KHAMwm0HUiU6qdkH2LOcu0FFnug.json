        "block_type": 2,
        "parent_id": "YBT2d16VdofY5vxE5Hfcscbwnbf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud has upgraded MFA for enhanced account security. Starting ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "November 25, 2025",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ", email-based MFA is deprecated. Users who previously used email-based MFA must switch to a TOTP authenticator app.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
