              "text_run": {
                "content": "register",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliverse.feishu.cn%2Fwiki%2FHriHwEU3qiQrgskz3a0cdkcpnyf%23BJhDdc7fjoN6vNxlaemcovCZnzd"
