      {
        "block_id": "GYMvds4lsoYewdx4d9XcFmFSnbh",
        "block_type": 2,
        "parent_id": "Dxe4dtrhgopRhyxH24ncUe2RnLf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Zilliz Cloud introduces auto-scaling, a feature that dynamically adjusts the cluster's capacity based on demand. Auto-scaling is primarily triggered by the CU (Compute Unit) Capacity Threshold. Zilliz Cloud monitors the cluster's CU capacity every minute, and if it exceeds 70% (the default threshold) for two consecutive minutes, the system automatically initiates a scaling process. Users can set a maximum CU size for automatic scaling, though downward auto-scaling is currently not supported.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "DCNVdbE6AorC8Ux8n7pcVXlMnoe",
