        "parent_id": "Dxe4dtrhgopRhyxH24ncUe2RnLf",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Auto-scaling is currently in private preview and available only for Dedicated (Enterprise) clusters. To enable this feature, please ",
