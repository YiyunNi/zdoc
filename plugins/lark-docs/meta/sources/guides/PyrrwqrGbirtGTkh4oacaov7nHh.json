      {
        "block_id": "SxpfdwDxbobF0wxBINPcixASnTb",
        "block_type": 5,
        "heading3": {
          "elements": [
            {
              "text_run": {
                "content": "Improved Capacity of Performance-optimized CU",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
