      },
      {
        "block_id": "QQ4fd3pD3opy6jxf0UFciaOJnxh",
        "block_type": 2,
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "With this release, the capacity of the performance-optimized CU (Compute Unit) has been increased by 50%. Previously, each performance-optimized CU could hold approximately 1 million vectors when estimated with 768-dimension vectors. Now, the capacity has been enhanced to 1.5 million vectors per CU. For large data volumes, this improvement can reduce CU costs by approximately 30%.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "DzrVdCDokouTVaxHX6gcb7h4ntb",
        "block_type": 2,
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd",
