            "folded": false
          }
        }
      },
      {
        "block_id": "Q7fHdXNCNojeMKxtHNbctn6vnqd",
        "block_type": 5,
        "heading3": {
          "elements": [
            {
              "text_run": {
                "content": "Multi-replica Generally Available",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd"
      },
      {
        "block_id": "PX67dmyuLom8ugxYgGUcPCfAnqg",
        "block_type": 2,
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "Multi-replica is now generally available in Zilliz Cloud, enabling cluster-level replication to boost both query throughput and availability.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "GohkdrHpnoJ1XAxo7uQcVb1AnPh",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Improved Query Performance",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ": For users requiring high query-per-second (QPS), multi-replica allows query workloads to be distributed across replicas. This parallel processing enhances overall throughput, reduces latency, and improves efficiency for query-intensive applications. In most cases, the overall QPS can be improved linearly as replicas are added.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd"
      },
      {
        "block_id": "Qj92dmzXvoPj5lxZoiTc6SeHnHg",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "Enhanced Availability",
                "text_element_style": {
                  "bold": true,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ": Multi-replica strengthens availability by distributing replicas across multiple Availability Zones (AZs). This setup ensures continuous access to data, even in the event of an AZ outage, offering greater reliability for mission-critical applications.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "TH7wdYQUToMDP5x6RfjcayZwnQd"
      },
