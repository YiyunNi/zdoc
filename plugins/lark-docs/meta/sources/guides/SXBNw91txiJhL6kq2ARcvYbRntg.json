                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fhelp.okta.com%2Fen-us%2Fcontent%2Ftopics%2Fapps%2Fapps_app_integration_wizard_saml.htm"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
