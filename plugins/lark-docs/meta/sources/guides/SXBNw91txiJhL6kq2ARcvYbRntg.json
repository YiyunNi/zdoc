                    "url": "https%3A%2F%2Fhelp.okta.com%2Fen-us%2Fcontent%2Ftopics%2Fapps%2Fapps_app_integration_wizard_oidc.htm"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ") or ",
