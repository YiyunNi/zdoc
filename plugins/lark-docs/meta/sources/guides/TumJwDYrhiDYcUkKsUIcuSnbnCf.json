      {
        "block_id": "IjIvdemiNoQrnaxiVA0c14nbnze",
        "block_type": 2,
        "parent_id": "QTCSdR1dYoI8DKxBzyhcQSDsnXt",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The same templating mechanism can be applied to query operations in <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud</include>. In the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "query",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " function, you define the filter expression and use the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "filter_params",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " to specify the values to substitute.",
                "text_element_style": {
