      },
      {
        "block_id": "SBKGdSSJgoKJUIxjwzWc1uXfnhd",
        "block_type": 2,
        "parent_id": "QTCSdR1dYoI8DKxBzyhcQSDsnXt",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "For search operations in <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud</include>, the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "filter",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " expression is used to define the filtering condition, and the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "filter_params",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " parameter is used to specify the values for the placeholders. The ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "filter_params",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " dictionary contains the dynamic values that <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud</include> will use to substitute into the filter expression.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "HdKRd5IrxoW3hBxgyDHcwJvmn9c",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "expr = \"age > {age} AND city IN {city}\"\nfilter_params = {\"age\": 25, \"city\": [\"北京\", \"上海\"]}\nres = client.search(\n    \"hello_milvus\",\n    vectors[:nq],\n    filter=expr,\n    limit=10,\n    output_fields=[\"age\", \"city\"],\n    search_params={\"metric_type\": \"COSINE\", \"params\": {\"search_list\": 100}},\n    filter_params=filter_params,\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ")",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 49,
            "wrap": false
          }
        },
        "parent_id": "QTCSdR1dYoI8DKxBzyhcQSDsnXt"
      },
      {
        "block_id": "BKojdrbeZozp7RxHLEWcdfpvn2e",
        "block_type": 2,
        "parent_id": "QTCSdR1dYoI8DKxBzyhcQSDsnXt",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "In this example, <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud</include> will dynamically replace ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "{age}",
                "text_element_style": {
