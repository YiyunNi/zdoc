      {
        "block_id": "MRM5dtJAaomw3Tx89X5cJPGTnEc",
        "block_type": 4,
        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "BYOC-I: A New Deployment Option That Provides Complete Data Sovereignty with Enhanced Project Management Capabilities",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
