      {
        "block_id": "UNRMdGPrXoEHFTxgmvmcsKNqnPe",
        "block_type": 4,
        "heading2": {
          "elements": [
            {
              "text_run": {
                "content": "Data Plane Audit Logs: Protect Your Data Operations with Comprehensive Action Logs for Auditing",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
