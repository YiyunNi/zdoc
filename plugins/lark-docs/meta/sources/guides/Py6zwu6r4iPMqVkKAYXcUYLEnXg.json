      {
        "block_id": "QBp7dsolJo4mUtxVPIlcNYSsn6c",
        "block_type": 12,
        "bullet": {
          "elements": [
            {
              "text_run": {
                "content": "JSON_CONTAINS(identifier, expr)",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliverse.feishu.cn%2Fwiki%2FPy6zwu6r4iPMqVkKAYXcUYLEnXg%23M2GodGcjMo6W9CxvgbNcUfLInHe"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ": Filters entities where the specified JSON expression is found within the field.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        },
        "parent_id": "OVFxduP7zoGbfNx8kg4cq4YfnDe"
