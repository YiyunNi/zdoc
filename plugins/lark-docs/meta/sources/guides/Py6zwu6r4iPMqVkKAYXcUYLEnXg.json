                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "link": {
                    "url": "https%3A%2F%2Fzilliverse.feishu.cn%2Fwiki%2FPy6zwu6r4iPMqVkKAYXcUYLEnXg%23CBaYdFr6jobrEGxTw4YcScJZndh"
                  },
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ": Ensures that all elements of the specified JSON expression are present in the field.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
