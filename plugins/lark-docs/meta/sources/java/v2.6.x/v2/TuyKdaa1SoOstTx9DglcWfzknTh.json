      {
        "block_id": "doxcnz8ra4LPVeVraoL8JOVdllh",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.bulkwriter.VolumeFileManager;\nimport io.milvus.bulkwriter.VolumeFileManagerParam;\nimport io.milvus.bulkwriter.common.clientenum.ConnectType;\nimport io.milvus.bulkwriter.model.UploadFilesResult;\nimport io.milvus.bulkwriter.request.volume.UploadFilesRequest;\n\n// Initialize VolumeFileManager\nVolumeFileManagerParam param = VolumeFileManagerParam.newBuilder()\n        .withCloudEndpoint(\"https://api.cloud.zilliz.com\")\n        .withApiKey(\"your_api_key\")\n        .withVolumeName(\"your_volume_name\")\n        .withConnectType(ConnectType.AUTO)\n        .build();\nVolumeFileManager manager = new VolumeFileManager(param);\n\n// Upload files asynchronously\nUploadFilesRequest request = UploadFilesRequest.builder()\n        .sourceFilePath(\"/path/to/data/\")\n        .targetVolumePath(\"data/\")\n        .build();\nUploadFilesResult result = manager.uploadFilesAsync(request).get();\n\n// Gracefully shut down the manager when done\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "manager.shutdownGracefully();",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
