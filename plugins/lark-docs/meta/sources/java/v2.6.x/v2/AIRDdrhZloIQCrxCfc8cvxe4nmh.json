        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.AddCollectionFunctionReq;\nimport io.milvus.v2.service.collection.request.CreateCollectionReq;\nimport io.milvus.common.clientenum.FunctionType;\n\nCreateCollectionReq.Function bm25Func = CreateCollectionReq.Function.builder()\n    .name(\"bm25\")\n    .functionType(FunctionType.BM25)\n    .inputFieldNames(Arrays.asList(\"text\"))\n    .outputFieldNames(Arrays.asList(\"sparse_vector\"))\n    .build();\n\nclient.addCollectionFunction(AddCollectionFunctionReq.builder()\n    .collectionName(\"my_collection\")\n    .function(bm25Func)\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "    .build());",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
