      {
        "block_id": "doxcnEXS7qjHQkdGdvkW662v5ff",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.client.ConnectConfig;\nimport io.milvus.v2.client.MilvusClientV2;\nimport io.milvus.v2.service.database.request.DropDatabasePropertiesReq;\n\n// 1. Set up a client\nConnectConfig connectConfig = ConnectConfig.builder()\n        .uri(\"http://localhost:19530\")\n        .token(\"root:Milvus\")\n        .build();\n        \nMilvusClientV2 client = new MilvusClientV2(connectConfig);\n\n// 2. Drop database properties\nList<String> propertyKeys = new ArrayList<>();\npropertyKeys.add(\"database.replica.number\");\n\nDropDatabasePropertiesReq dropDatabasePropertiesReq = DropDatabasePropertiesReq.builder()\n        .databaseName(databaseName)\n        .propertyKeys(propertyKeys)\n        .build();\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "client.dropDatabaseProperties(alterDatabaseReq);",
