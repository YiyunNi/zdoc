      {
        "block_id": "doxcnlLkHzw0rNETrxMwXBc5vRc",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.AlterCollectionFunctionReq;\nimport io.milvus.v2.service.collection.request.CreateCollectionReq;\nimport io.milvus.common.clientenum.FunctionType;\n\nCreateCollectionReq.Function updatedFunc = CreateCollectionReq.Function.builder()\n    .name(\"bm25\")\n    .functionType(FunctionType.BM25)\n    .inputFieldNames(Arrays.asList(\"text\"))\n    .outputFieldNames(Arrays.asList(\"sparse_vector\"))\n    .param(\"bm25_k1\", \"1.5\")\n    .param(\"bm25_b\", \"0.75\")\n    .build();\n\nclient.alterCollectionFunction(AlterCollectionFunctionReq.builder()\n    .collectionName(\"my_collection\")\n    .function(updatedFunc)\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "    .build());",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
