      {
        "block_id": "doxcn2915ZexRoodbi9Iez4IPf0",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.orm.iterator.QueryIterator;\nimport io.milvus.response.QueryResultsWrapper;\nimport io.milvus.v2.service.vector.request.QueryIteratorReq;\nimport io.milvus.v2.common.ConsistencyLevel;\n\nimport java.util.Arrays;\nimport java.util.List;\n\n// Create a query iterator to retrieve results in batches\nQueryIterator queryIterator = client.queryIterator(QueryIteratorReq.builder()\n        .collectionName(\"my_collection\")\n        .expr(\"userID < 3000\")\n        .outputFields(Arrays.asList(\"userID\", \"userAge\"))\n        .batchSize(100)\n        .offset(0)\n        .limit(10000)\n        .consistencyLevel(ConsistencyLevel.BOUNDED)\n        .build());\n\n// Iterate through all results\nint counter = 0;\nwhile (true) {\n    List<QueryResultsWrapper.RowRecord> res = queryIterator.next();\n    if (res.isEmpty()) {\n        queryIterator.close();\n        break;\n    }\n    for (QueryResultsWrapper.RowRecord record : res) {\n        System.out.println(record);\n        counter++;\n    }\n}\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "System.out.printf(\"%d query results returned%n\", counter);",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 29,
            "wrap": false
          }
        },
        "parent_id": "A0I6dpXMsofjaVxE0RLcOW3nnWe"
      }
