        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.CreateCollectionReq.Function;\nimport io.milvus.v2.service.vector.request.ranker.WeightedRanker\nimport java.util.Collections;\n\n// use the WeightedRanker class\nWeightedRanker.builder()\n    .weights([0.4, 0.6])\n    .build());\n    \n// Instead, you can use the Function class as well\nCreateCollectionReq.Function rr = CreateCollectionReq.Function.builder()\n    .functionType(FunctionType.RERANK)\n    .param(\"strategy\", \"weighted\")\n    .param(\"params\", \"{\\\"weights\\\": [0.4, 0.6]}\")\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
