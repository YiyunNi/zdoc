      {
        "block_id": "doxcn8K1IRfP3t5athISI8o4z0e",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.AddCollectionFieldReq;\nimport io.milvus.v2.common.DataType;\n\n// Add a nullable VarChar field to an existing collection.\n// The new field must be nullable so that existing rows get null values.\nclient.addCollectionField(AddCollectionFieldReq.builder()\n        .collectionName(\"my_collection\")\n        .fieldName(\"text\")\n        .dataType(DataType.VarChar)\n        .maxLength(100)\n        .isNullable(true)\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "        .build());",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 29,
            "wrap": false
          }
        },
