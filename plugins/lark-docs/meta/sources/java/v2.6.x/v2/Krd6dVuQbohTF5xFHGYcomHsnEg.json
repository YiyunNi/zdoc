              "text_run": {
                "content": "import io.milvus.v2.service.vector.request.highlighter.LexicalHighlighter;\nimport java.util.ArrayList;\nimport java.util.List;\n\nLexicalHighter.HighlightQuery q = new LexicalHighlighter.HighlighterQuery(\n    \"<QueryType>\",\n    \"<text field name>\",\n    \"<terms to highlight>\"\n)\n\nList<LexicalHighter.HighlightQuery> queries = new ArrayList<>();\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
