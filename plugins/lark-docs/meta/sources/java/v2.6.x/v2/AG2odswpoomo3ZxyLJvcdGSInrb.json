      {
        "block_id": "Bpzxdc2OJoCmGrxEsJaciBi1nPf",
        "block_type": 2,
        "parent_id": "FZ9ZdY8jWopQ1uxQlZScFx9wnNM",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "How can I label a query node?",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "ZcGod2Rr1ou7Pbx8o4fcTgKyn3b",
        "block_type": 2,
        "parent_id": "FZ9ZdY8jWopQ1uxQlZScFx9wnNM",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "You can set an environment variable for Milvus to label the query node during its startup. For example, to add the ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "QUERYNODE_LOCATION",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " label, you need to create an environment variable named after the label, prefixed by ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "MILVUS_SERVER_LABEL_",
                "text_element_style": {
                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": ", and set the value for the label, as in ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "MILVUS_SERVER_LABEL_QUERYNODE_LOCATION=dc1",
