      },
      {
        "block_id": "HifHdj16qomRMBxMlg3cBwJmnuh",
        "block_type": 2,
        "parent_id": "DCszdG9rCoZxhfxfAuOcNsXRnOc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "The following example illustrates how to create an Array of Structs field and add fields to its Struct elements. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "VL71dGBcqoe8UXxRdeQcRi4InDf",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.common.DataType;",
                "text_element_style": {
                  "bold": false,
                  "comment_ids": [
                    "7565780067977822212"
                  ],
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.AddFieldReq;",
                "text_element_style": {
                  "bold": false,
                  "comment_ids": [
                    "7565780067977822212"
                  ],
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.CreateCollectionReq;",
                "text_element_style": {
                  "bold": false,
                  "comment_ids": [
                    "7565780067977822212"
                  ],
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\n\nCreateCollectionReq.CollectionSchema collectionSchema = CreateCollectionReq.CollectionSchema.builder()\n        .build();\n        \ncollectionSchema.addField(AddFieldReq.builder()\n        .fieldName(STRUCT_FIELD)\n        .description(\"clips of a film\")\n        .dataType(DataType.Array)\n        .elementType(DataType.Struct)\n        .maxCapacity(100)\n        .addStructField(AddFieldReq.builder()\n                .fieldName(FRAME_FIELD)\n                .description(\"from which frame this clip begin\")\n                .dataType(DataType.Int32)\n                .build())\n        .addStructField(AddFieldReq.builder()\n                .fieldName(CLIP_VECTOR_FIELD)\n                .description(\"embedding of a clip\")\n                .dataType(DataType.FloatVector)\n                .dimension(VECTOR_DIM)\n                .build())\n        .addStructField(AddFieldReq.builder()\n                .fieldName(DESC_FIELD)\n                .description(\"description of a clip\")\n                .dataType(DataType.VarChar)\n                .maxLength(1024)\n                .build())\n        .addStructField(AddFieldReq.builder()\n                .fieldName(DESC_VECTOR_FIELD)\n                .description(\"embedding of description\")\n                .dataType(DataType.FloatVector)\n                .dimension(VECTOR_DIM)\n                .build())\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "        .build());",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
