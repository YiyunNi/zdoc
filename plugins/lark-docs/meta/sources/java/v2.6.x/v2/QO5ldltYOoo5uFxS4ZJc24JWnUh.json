        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import io.milvus.v2.service.collection.request.CreateCollectionReq.Function;\nimport io.milvus.v2.service.vector.request.ranker.BoostRanker\nimport java.util.Collections;\n\n// use the ModelRanker class\nBoostRanker boost = BoostRanker.builder()\n    .name(\"xxx_boost\")\n    .description(\"boost on xxx\")\n    .filter(\"xxx == 2\")\n    .weight(0.5)\n    .randomScoreSeed(123)\n    .randomScoreField(\"id\")\n    .build()\n    \n// Instead, you can use the Function class as well\nCreateCollectionReq.Function boost = CreateCollectionReq.Function.builder()\n    .functionType(FunctionType.RERANK)\n    .name(\"xxx_boost\")\n    .description(\"boost on xxx\")\n    .param(\"reranker\", \"boost\")\n    .param(\"filter\", \"xxx == 2\")\n    .param(\"weight\", \"0.5\")\n    .param(\"random_score\", \"{\\\"seed\\\": 123, \\\"field\\\": \\\"id\\\"}\")\n",
                "text_element_style": {
                  "bold": false,
