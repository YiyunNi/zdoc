      {
        "block_id": "doxcnHfPsLsf8DBcIavonRN5Kxh",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "import com.google.gson.JsonObject;\nimport io.milvus.v2.client.ConnectConfig;\nimport io.milvus.v2.client.MilvusClientV2;\nimport io.milvus.v2.service.vector.request.InsertReq;\n\n// 1. Set up a client\nConnectConfig connectConfig = ConnectConfig.builder()\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "        .uri(\"",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "http://localhost:19530",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "\")\n        .token(\"root:Milvus\")\n        .build();\n        \nMilvusClientV2 client = new MilvusClientV2(connectConfig);\n\n// 2. Add one row to the collection, the collection has an \"id\" field\n// and a \"vector\" field with dimension 2\nJsonObject row = new JsonObject();\nList<Float> vectorList = new ArrayList<>();\nvectorList.add(1.0f);\nvectorList.add(2.0f);\nrow.add(\"vector\", gson.toJsonTree(vectorList));\nrow.addProperty(\"id\", 0L);\n\nInsertReq insertReq = InsertReq.builder()\n        .collectionName(\"test\")\n        .data(Collections.singletonList(row))\n        .build();\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "client.insert(insertReq);",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "language": 29,
            "wrap": false
          }
        },
