        }
      },
      {
        "block_id": "doxcn9wUBiks46e0yHOuLiYT0gd",
        "block_type": 2,
        "parent_id": "doxcnEOxHkWERrZkZaaWSr8zRjc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "A collection alias is an additional name for a collection. Collection aliases are useful when you want to switch your application to a new collection without any changes to your code. ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
      {
        "block_id": "doxcnsOOhyxLb9GTWDxvs7cGopd",
        "block_type": 2,
        "parent_id": "doxcnEOxHkWERrZkZaaWSr8zRjc",
        "text": {
          "elements": [
            {
              "text_run": {
                "content": "<include target=\"milvus\">In Milvus</include><include target=\"zilliz\">On Zilliz Cloud</include>, a collection alias is a globally unique identifier. One alias can only be assigned to exactly one collection. Conversely, a collection can have multiple aliases.",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            }
          ],
          "style": {
            "align": 1,
            "folded": false
          }
        }
      },
