apiVersion: v1
kind: Secret
metadata:
  name: chat-proxy-secrets
type: Opaque
stringData:
  DATABASE_URL: postgres://chatproxy:CHANGEME@chat-proxy-postgres:5432/chatproxy
  POSTGRES_PASSWORD: CHANGEME
  AI_API_KEY: CHANGEME
  AI_BASE_URL: https://openrouter.ai/api/v1
  AI_MODEL: anthropic/claude-sonnet-4.6
  GENERAL_MODEL: qwen/qwen3.6-plus
  RESOURCES_MODEL: qwen/qwen3.6-plus
  PRODUCT_MODEL: qwen/qwen3.6-plus
  CODE_MODEL: anthropic/claude-sonnet-4.6
  SCHEMA_MODEL: anthropic/claude-sonnet-4.6
  REWRITE_MODEL: qwen/qwen3.6-plus
  GROUNDING_MODEL: qwen/qwen3.6-plus
  EMBEDDING_API_KEY: CHANGEME
  ADMIN_API_KEY: CHANGEME
