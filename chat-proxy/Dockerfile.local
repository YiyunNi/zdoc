FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY dist/ ./dist/
COPY src/admin-dashboard.html ./dist/
COPY prompts/ ./prompts/
COPY data/GeoLite2-Country.mmdb ./data/GeoLite2-Country.mmdb
COPY package.json ./

ENV PORT=8787 \
    ALLOWED_ORIGINS="*" \
    GEOLITE2_DB_PATH=/app/data/GeoLite2-Country.mmdb

EXPOSE 8787

CMD ["node", "dist/server.js"]